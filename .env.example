# Vercel environment variables — copy to .env.local for local testing
# NEVER commit actual values to Git

# Notion integration token (Internal Integration)
# Create at: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# Shared secret between FocusFlow extension and this backend
# Generate a strong random string (e.g., openssl rand -hex 32)
FOCUSFLOW_SYNC_KEY=your_shared_secret_here
